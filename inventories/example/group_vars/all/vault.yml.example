---
# Copy to vault.yml and encrypt: ansible-vault encrypt group_vars/all/vault.yml
# (later: replace with an Infisical lookup)

# Bearer tokens for API clients (nginx)
vault_llm_api_keys:
  - "change-me-long-random-token"

# Hugging Face token: only needed for gated models (Llama, Gemma, ...)
vault_hf_token: ""

vault_grafana_admin_password: "change-me"

# VictoriaMetrics basic auth (openssl rand -hex 24)
vault_monitoring_write_password: "change-me"
